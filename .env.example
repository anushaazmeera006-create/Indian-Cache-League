# ICL configuration — copy to .env and adjust.

# PostgreSQL connection string used by all backend instances.
DATABASE_URL=postgres://icl:iclpass@postgres:5432/icl?sslmode=disable

# Backend instances
PORT=8080
INSTANCE_ID=backend-1
CACHE_ENABLED=true
CACHE_TTL=2s
CACHE_MAX_ENTRIES=10000
DB_MAX_CONNS=25
READ_TIMEOUT=10s

# Where the built-in traffic simulator sends requests.
# In docker-compose this should be http://nginx so traffic crosses the LB.
SIM_TARGET_URL=http://nginx

# Frontend build-time API target (vite dev proxy).
VITE_API_TARGET=http://localhost:8080
